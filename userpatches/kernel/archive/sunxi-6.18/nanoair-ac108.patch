+	 * driver binds via the second entry. Label gives the sound card a
+	 * proper phandle reference. */
+	ac108: ac108@3b {
+		compatible = "x-power,ac108e", "x-power,ac108c";
+		reg = <0x3b>;
+		#sound-dai-cells = <0>;
+	};
+};
+
+&codec {
+	status = "okay";
+	allwinner,audio-routing = "Speaker", "LINEOUT";
+};
+
+/*
+ * The legacy vendor-overlay sound card must never wake up and grab i2s0,
+ * so pin it disabled; the real 4-mic array card is "voicen4mic":
+ * cpu = i2s0 (H3 drives bitclock/frame), codec = the AC108 capture codec.
+ * The wire stream (2ch x 2*fs, channel tag in the low 2 bits of each
+ * word) is exposed at hw:1,0 and decoded in userspace by the "ac108"
+ * ALSA ioplug.
+ */
+/ {
+	sound_voicen_mic {
+		status = "disabled";
+	};
+
+	sound-micgen {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "voicen4mic";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <128>;
+		simple-audio-card,bitclock-master = <&cpudai>;
+		simple-audio-card,frame-master = <&cpudai>;
+		status = "okay";
+
+		cpudai: simple-audio-card,cpu {
+			sound-dai = <&i2s0>;
+		};
+
+		coddai: simple-audio-card,codec {
+			sound-dai = <&ac108>;
+		};
+	};
+};
