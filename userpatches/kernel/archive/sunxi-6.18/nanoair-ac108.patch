 };
 
 &uart0 {
@@ -294,3 +294,65 @@
 	/* USB VBUS is always on */
 	status = "okay";
 };
+
+/* NanoPi Air mic-array + amp + USB-gadget board setup (user patch) */
+
+&pio {
+	voicen_i2s0_pins: voicen-i2s0-pins {
+		pins = "PA18", "PA19", "PA20", "PA21";
+		function = "i2s0";
+	};
+
+	/* Nano-AMP (HT6873): PA2 power-enable (active high), PA3 mute# */
+	amp-hog {
+		gpio-hog;
+		gpios = <0 2 0>, <0 3 0>;
+		output-high;
+		line-name = "amp-pwr-en", "amp-mute-n";
+	};
+};
+
+&i2s0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&voicen_i2s0_pins>;
+	status = "okay";
+};
+
+&i2c0 {
+	status = "okay";
+
+	ac108: ac108@3b {
+		compatible = "x-power,ac108e";
+		reg = <0x3b>;
+	};
+};
+
+&codec {
+	status = "okay";
+	allwinner,audio-routing = "Speaker", "LINEOUT";
+};
+
+/*
+ * Capture-only loopback card: both cpu and codec point at i2s0, so the
+ * wire stream (AC108 encoded, 2ch x 2*rate) is exposed at hw:1,0 and is
+ * decoded in userspace by the "ac108" ALSA ioplug.
+ */
+/ {
+	sound-micgen {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "micgen";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <128>;
+		simple-audio-card,bitclock-master = <&cpudai>;
+		simple-audio-card,frame-master = <&cpudai>;
+		status = "okay";
+
+		cpudai: simple-audio-card,cpu {
+			sound-dai = <&i2s0>;
+		};
+
+		coddai: simple-audio-card,codec {
+			sound-dai = <&i2s0>;
+		};
+	};
+};
