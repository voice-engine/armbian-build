diff --git a/sound/soc/codecs/ac108c.c b/sound/soc/codecs/ac108c.c
new file mode 100644
index 0000000..4f8cae3
--- /dev/null
+++ b/sound/soc/codecs/ac108c.c
@@ -0,0 +1,367 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ac108-codec - AC108 编码模式 capture codec（ASoC，结构照抄 seeed-voicecard master）
+ *
+ * 线上流 = 2ch @ 2xfs 编码（低 2 位 tag），解码在用户空间（ac108 插件/voice_engine）。
+ * 配置全自动：
+ *   probe      上电配方（编码模式/4槽/恒等映射/晶振PLL/从机 GEN on）
+ *   hw_params  ADC 速率码 = 线上率/2（96k->8, 32k->3）；BCLK 源在用则换分频
+ *   trigger ST pll_bclk=1(默认) 时翻 BCLK-PLL（CPU DAI 先触发=BCLK 已在跑，0ppm）
+ *   trigger SP 退回晶振安全态（PLL 无 BCLK 使能永不捕获）
+ * DAPM 微件/路由 = seeed-voicecard ac108.c 原版（生产验证）。
+ * 仅 capture DAI（历史 panic 模块带 playback DAI，刻意不做）。
+ * compatible = "x-power,ac108c"（独立于 ac108_init 的 x-power,ac108e，避免 OF
+ * modalias 双加载；DT 由 micgen-mode.sh codec 分支追加）。
+ */
+#include <linux/module.h>
+#include <linux/i2c.h>
+#include <linux/delay.h>
+#include <linux/slab.h>
+#include <sound/soc.h>
+#include <sound/pcm.h>
+#include <sound/tlv.h>
+
+static int pll_bclk = 1;	/* 1=trigger 翻 BCLK-PLL(0ppm) 0=保持晶振 */
+module_param(pll_bclk, int, 0444);
+MODULE_PARM_DESC(pll_bclk, "1=BCLK-PLL on trigger (0ppm), 0=crystal PLL");
+
+/* AC108 寄存器位（照抄 seeed ac108.h，仅本驱动用到的） */
+#define ADC_DIG_EN			0x61
+#define ENAD1				0
+#define ENAD2				1
+#define ENAD3				2
+#define ENAD4				3
+#define DG_EN				4
+#define DMIC_EN				0x62
+#define ANA_ADC1_CTRL1			0xa0
+#define ADC1_DSM_ENABLE			2
+#define ADC1_PGA_ENABLE			1
+#define ADC1_MICBIAS_EN			0
+#define ANA_ADC2_CTRL1			0xa7
+#define ADC2_DSM_ENABLE			2
+#define ADC2_PGA_ENABLE			1
+#define ADC2_MICBIAS_EN			0
+#define ANA_ADC3_CTRL1			0xae
+#define ADC3_DSM_ENABLE			2
+#define ADC3_PGA_ENABLE			1
+#define ADC3_MICBIAS_EN			0
+#define ANA_ADC4_CTRL1			0xb5
+#define ADC4_DSM_ENABLE			2
+#define ADC4_PGA_ENABLE			1
+#define ADC4_MICBIAS_EN			0
+#define ANA_ADC4_CTRL6			0xba
+#define DSM_DEMOFF			5
+#define ANA_ADC4_CTRL7			0xbb
+#define ADC1_CLK_GATING			0
+#define ADC2_CLK_GATING			1
+#define ADC3_CLK_GATING			2
+#define ADC4_CLK_GATING			3
+
+struct ac108_priv {
+	struct i2c_client	*client;
+	bool			codec_slave;
+	bool			bclk_pll;
+	unsigned int		wire_rate;	/* 32000|96000 */
+};
+
+static int wr(struct ac108_priv *ac, u8 reg, u8 val)
+{
+	int ret = i2c_smbus_write_byte_data(ac->client, reg, val);
+	if (ret < 0)
+		dev_err(&ac->client->dev, "wr 0x%02x<-0x%02x: %d\n", reg, val, ret);
+	return ret;
+}
+
+static int rd(struct ac108_priv *ac, u8 reg)
+{
+	return i2c_smbus_read_byte_data(ac->client, reg);
+}
+
+static const struct regval {
+	u8 reg, val;
+} recipe[] = {
+	{0x06, 0x01}, {0x07, 0x19}, {0x09, 0x09},	/* 模拟 LDO/VREF */
+	{0x11, 4}, {0x12, 0}, {0x13, 128}, {0x14, 24},	/* 晶振 PLL 24M->24.576M */
+	{0x18, 0x01}, {0x10, 0x0b},			/* PLL 锁定/使能 */
+	{0x20, 0x89},	/* SYSCLK<-PLL（0x89: bit3=PLL源；0x83=MCLK直通24M 陷阱）*/
+	{0x21, 0x95}, {0x22, 0x95},			/* 模块时钟/复位释放 */
+	{0x31, 0x00}, {0x32, 0x00},
+	{0x34, 0x5d},	/* 编码模式(ENCD_SEL=bit6)+LJ —— 0x3d 不是编码位 */
+	{0x35, 0x77},	/* 32bit 采样 + 32bit slot */
+	{0x33, 31},	/* LRCK 半周期 32 BCLK -> 线上 = 2xfs */
+	{0x36, 0x60},
+	{0x38, 3}, {0x39, 0x0f}, {0x3a, 0x00},		/* TX1 = 4 槽 */
+	{0x3c, 0xe4},	/* slot1..4 <- adc1..4 恒等（tag=ADC序号-1）*/
+	{0x60, 8},	/* ADC 速率码（hw_params 校正：96k线->8, 32k线->3）*/
+	{0x66, 0x0f},
+	{0x61, 0x1f},
+	{0xa0, 7}, {0xa7, 7}, {0xae, 7}, {0xb5, 7},
+	{0xbb, 0x0f}, {0xba, 0},
+	{0x90, 0}, {0x91, 0}, {0x92, 0}, {0x93, 0},
+	{0x70, 222}, {0x71, 222}, {0x72, 222}, {0x73, 222},
+};
+
+/* BCLK-PLL 分频表（seeed 原厂表条目，FIN=BCLK=2*fs*64 -> 24.576M） */
+static void write_dividers(struct ac108_priv *ac, int bclk)
+{
+	if (bclk) {
+		if (ac->wire_rate == 32000) {	/* BCLK 2.048M */
+			wr(ac, 0x11, 0); wr(ac, 0x12, 0); wr(ac, 0x13, 240); wr(ac, 0x14, 0x29);
+		} else {			/* BCLK 6.144M */
+			wr(ac, 0x11, 4); wr(ac, 0x12, 1); wr(ac, 0x13, 144); wr(ac, 0x14, 0x29);
+		}
+	} else {				/* 晶振 24M -> 24.576M */
+		wr(ac, 0x11, 4); wr(ac, 0x12, 0); wr(ac, 0x13, 128); wr(ac, 0x14, 24);
+	}
+}
+
+/* ---------------- DAPM（照抄 seeed-voicecard ac108.c） ---------------- */
+
+static const struct snd_soc_dapm_widget ac108_dapm_widgets[] = {
+	SND_SOC_DAPM_INPUT("MIC1P"), SND_SOC_DAPM_INPUT("MIC1N"),
+	SND_SOC_DAPM_INPUT("MIC2P"), SND_SOC_DAPM_INPUT("MIC2N"),
+	SND_SOC_DAPM_INPUT("MIC3P"), SND_SOC_DAPM_INPUT("MIC3N"),
+	SND_SOC_DAPM_INPUT("MIC4P"), SND_SOC_DAPM_INPUT("MIC4N"),
+	SND_SOC_DAPM_INPUT("DMIC1"), SND_SOC_DAPM_INPUT("DMIC2"),
+
+	SND_SOC_DAPM_AIF_IN("Channel 1 AAF", "Capture", 0, ANA_ADC1_CTRL1, ADC1_DSM_ENABLE, 1),
+	SND_SOC_DAPM_SUPPLY("Channel 1 EN", ANA_ADC1_CTRL1, ADC1_PGA_ENABLE, 1, NULL, 0),
+	SND_SOC_DAPM_MICBIAS("MIC1BIAS", ANA_ADC1_CTRL1, ADC1_MICBIAS_EN, 1),
+
+	SND_SOC_DAPM_AIF_IN("Channel 2 AAF", "Capture", 0, ANA_ADC2_CTRL1, ADC2_DSM_ENABLE, 1),
+	SND_SOC_DAPM_SUPPLY("Channel 2 EN", ANA_ADC2_CTRL1, ADC2_PGA_ENABLE, 1, NULL, 0),
+	SND_SOC_DAPM_MICBIAS("MIC2BIAS", ANA_ADC2_CTRL1, ADC2_MICBIAS_EN, 1),
+
+	SND_SOC_DAPM_AIF_IN("Channel 3 AAF", "Capture", 0, ANA_ADC3_CTRL1, ADC3_DSM_ENABLE, 1),
+	SND_SOC_DAPM_SUPPLY("Channel 3 EN", ANA_ADC3_CTRL1, ADC3_PGA_ENABLE, 1, NULL, 0),
+	SND_SOC_DAPM_MICBIAS("MIC3BIAS", ANA_ADC3_CTRL1, ADC3_MICBIAS_EN, 1),
+
+	SND_SOC_DAPM_AIF_IN("Channel 4 AAF", "Capture", 0, ANA_ADC4_CTRL1, ADC4_DSM_ENABLE, 1),
+	SND_SOC_DAPM_SUPPLY("Channel 4 EN", ANA_ADC4_CTRL1, ADC4_PGA_ENABLE, 1, NULL, 0),
+	SND_SOC_DAPM_MICBIAS("MIC4BIAS", ANA_ADC4_CTRL1, ADC4_MICBIAS_EN, 1),
+
+	SND_SOC_DAPM_SUPPLY("ADC EN", ADC_DIG_EN, DG_EN, 1, NULL, 0),
+	SND_SOC_DAPM_ADC("ADC1", "Capture", ADC_DIG_EN, ENAD1, 1),
+	SND_SOC_DAPM_ADC("ADC2", "Capture", ADC_DIG_EN, ENAD2, 1),
+	SND_SOC_DAPM_ADC("ADC3", "Capture", ADC_DIG_EN, ENAD3, 1),
+	SND_SOC_DAPM_ADC("ADC4", "Capture", ADC_DIG_EN, ENAD4, 1),
+
+	SND_SOC_DAPM_SUPPLY("ADC1 CLK", ANA_ADC4_CTRL7, ADC1_CLK_GATING, 1, NULL, 0),
+	SND_SOC_DAPM_SUPPLY("ADC2 CLK", ANA_ADC4_CTRL7, ADC2_CLK_GATING, 1, NULL, 0),
+	SND_SOC_DAPM_SUPPLY("ADC3 CLK", ANA_ADC4_CTRL7, ADC3_CLK_GATING, 1, NULL, 0),
+	SND_SOC_DAPM_SUPPLY("ADC4 CLK", ANA_ADC4_CTRL7, ADC4_CLK_GATING, 1, NULL, 0),
+
+	SND_SOC_DAPM_SUPPLY("DSM EN", ANA_ADC4_CTRL6, DSM_DEMOFF, 1, NULL, 0),
+
+	SND_SOC_DAPM_MICBIAS("DMIC1 enable", DMIC_EN, 0, 0),
+	SND_SOC_DAPM_MICBIAS("DMIC2 enable", DMIC_EN, 1, 0),
+};
+
+static const struct snd_soc_dapm_route ac108_dapm_routes[] = {
+	{ "ADC1", NULL, "Channel 1 AAF" },
+	{ "ADC2", NULL, "Channel 2 AAF" },
+	{ "ADC3", NULL, "Channel 3 AAF" },
+	{ "ADC4", NULL, "Channel 4 AAF" },
+
+	{ "Channel 1 AAF", NULL, "MIC1BIAS" },
+	{ "Channel 2 AAF", NULL, "MIC2BIAS" },
+	{ "Channel 3 AAF", NULL, "MIC3BIAS" },
+	{ "Channel 4 AAF", NULL, "MIC4BIAS" },
+
+	{ "MIC1BIAS", NULL, "ADC1 CLK" },
+	{ "MIC2BIAS", NULL, "ADC2 CLK" },
+	{ "MIC3BIAS", NULL, "ADC3 CLK" },
+	{ "MIC4BIAS", NULL, "ADC4 CLK" },
+
+	{ "ADC1 CLK", NULL, "DSM EN" },
+	{ "ADC2 CLK", NULL, "DSM EN" },
+	{ "ADC3 CLK", NULL, "DSM EN" },
+	{ "ADC4 CLK", NULL, "DSM EN" },
+
+	{ "DSM EN", NULL, "ADC EN" },
+
+	{ "Channel 1 EN", NULL, "DSM EN" },
+	{ "Channel 2 EN", NULL, "DSM EN" },
+	{ "Channel 3 EN", NULL, "DSM EN" },
+	{ "Channel 4 EN", NULL, "DSM EN" },
+
+	{ "MIC1P", NULL, "Channel 1 EN" },
+	{ "MIC1N", NULL, "Channel 1 EN" },
+	{ "MIC2P", NULL, "Channel 2 EN" },
+	{ "MIC2N", NULL, "Channel 2 EN" },
+	{ "MIC3P", NULL, "Channel 3 EN" },
+	{ "MIC3N", NULL, "Channel 3 EN" },
+	{ "MIC4P", NULL, "Channel 4 EN" },
+	{ "MIC4N", NULL, "Channel 4 EN" },
+};
+
+/* ---------------- DAI ops ---------------- */
+
+static int ac108_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct ac108_priv *ac = snd_soc_dai_get_drvdata(dai);
+
+	switch (fmt & SND_SOC_DAIFMT_MASTER_MASK) {
+	case SND_SOC_DAIFMT_CBP_CFC:	/* AC108 从机（时钟 consumer，唯一支持）*/
+		ac->codec_slave = true;
+		break;
+	default:
+		ac->codec_slave = false;
+		return -ENOTSUPP;
+	}
+	return 0;
+}
+
+static int ac108_hw_params(struct snd_pcm_substream *ss,
+			   struct snd_pcm_hw_params *p, struct snd_soc_dai *dai)
+{
+	struct ac108_priv *ac = snd_soc_dai_get_drvdata(dai);
+	unsigned int rate = params_rate(p);
+	unsigned int fs = rate / 2;
+	int src, lock;
+
+	if (ss->stream != SNDRV_PCM_STREAM_CAPTURE)
+		return -EINVAL;
+	if (fs != 48000 && fs != 16000)
+		return -EINVAL;
+	ac->wire_rate = rate;
+
+	wr(ac, 0x60, (fs == 16000) ? 3 : 8);
+
+	/* BCLK 源在用时: 锁定=线上有钟 -> 换分频+EN 重锁; 失锁 -> 退晶振安全态 */
+	src = rd(ac, 0x20);
+	lock = (rd(ac, 0x10) & 0x04) != 0;
+	if ((src & 0x10) && lock) {
+		write_dividers(ac, 1);
+		wr(ac, 0x10, 0x0a); wr(ac, 0x10, 0x0b);
+	} else if ((src & 0x10) && !lock) {
+		write_dividers(ac, 0);
+		wr(ac, 0x20, 0x89);
+	}
+	dev_info(&ac->client->dev, "hw_params: wire=%u fs=%u 0x60=%02x\n",
+		 rate, fs, rd(ac, 0x60));
+	return 0;
+}
+
+static int ac108_trigger(struct snd_pcm_substream *ss, int cmd, struct snd_soc_dai *dai)
+{
+	struct ac108_priv *ac = snd_soc_dai_get_drvdata(dai);
+
+	if (!ac->bclk_pll || !ac->codec_slave)
+		return 0;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		/* CPU DAI 已先触发 => BCLK 在跑；已锁晶振状态下翻源自动重捕获 */
+		write_dividers(ac, 1);
+		wr(ac, 0x20, 0x99);
+		dev_info(&ac->client->dev, "trigger: BCLK-PLL on (0x20=%02x 0x10=%02x)\n",
+			 rd(ac, 0x20), rd(ac, 0x10));
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		write_dividers(ac, 0);
+		wr(ac, 0x20, 0x89);
+		dev_info(&ac->client->dev, "trigger: back to crystal PLL\n");
+		break;
+	}
+	return 0;
+}
+
+static const struct snd_soc_dai_ops ac108_dai_ops = {
+	.set_fmt	= ac108_set_fmt,
+	.hw_params	= ac108_hw_params,
+	.trigger	= ac108_trigger,
+};
+
+static struct snd_soc_dai_driver ac108_dai = {
+	.name = "ac108-hifi",
+	.capture = {
+		.stream_name	= "Capture",
+		.channels_min	= 2,
+		.channels_max	= 2,
+		.rates		= SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_96000,
+		.formats	= SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &ac108_dai_ops,
+};
+
+/* 组件读写回调（DAPM 微件经此写寄存器；签名与 6.18 snd_soc_component_driver 匹配） */
+static int ac108_comp_write(struct snd_soc_component *c, unsigned int reg,
+			    unsigned int val)
+{
+	struct ac108_priv *ac = dev_get_drvdata(c->dev);
+	return wr(ac, reg, val);
+}
+
+static unsigned int ac108_comp_read(struct snd_soc_component *c,
+				     unsigned int reg)
+{
+	struct ac108_priv *ac = dev_get_drvdata(c->dev);
+	return (unsigned int)max(rd(ac, reg), 0);
+}
+
+static const struct snd_soc_component_driver ac108_component = {
+	.name			= "ac108-codec",
+	.read			= ac108_comp_read,
+	.write			= ac108_comp_write,
+	.dapm_widgets		= ac108_dapm_widgets,
+	.num_dapm_widgets	= ARRAY_SIZE(ac108_dapm_widgets),
+	.dapm_routes		= ac108_dapm_routes,
+	.num_dapm_routes	= ARRAY_SIZE(ac108_dapm_routes),
+	.idle_bias_on		= 1,
+	.use_pmdown_time	= 1,
+};
+
+static int ac108_codec_probe(struct i2c_client *client)
+{
+	struct ac108_priv *ac;
+	int i;
+
+	ac = devm_kzalloc(&client->dev, sizeof(*ac), GFP_KERNEL);
+	if (!ac)
+		return -ENOMEM;
+	ac->client = client;
+	ac->bclk_pll = pll_bclk;
+	i2c_set_clientdata(client, ac);
+
+	/* CHIP_RST: 本芯片复位值 0x00（0x12 NAK）*/
+	wr(ac, 0x00, 0x00);
+	msleep(500);
+	wr(ac, 0x30, 0x00);
+	for (i = 0; i < ARRAY_SIZE(recipe); i++)
+		wr(ac, recipe[i].reg, recipe[i].val);
+	wr(ac, 0x30, 0x35);	/* 从机: SDO+TXEN+GEN（H3 驱动时钟）*/
+
+	dev_info(&client->dev, "probed (bclk-pll=%d), recipe armed\n", ac->bclk_pll);
+	return devm_snd_soc_register_component(&client->dev, &ac108_component,
+					       &ac108_dai, 1);
+}
+
+static const struct of_device_id ac108_of_match[] = {
+	{ .compatible = "x-power,ac108c" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ac108_of_match);
+
+static struct i2c_device_id ac108_ids[] = {
+	{ "ac108-codec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, ac108_ids);
+
+static struct i2c_driver ac108_codec_driver = {
+	.driver = {
+		.name		= "ac108-codec",
+		.of_match_table	= ac108_of_match,
+	},
+	.probe		= ac108_codec_probe,
+	.id_table	= ac108_ids,
+};
+module_i2c_driver(ac108_codec_driver);
+
