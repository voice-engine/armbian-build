diff --git a/sound/soc/sunxi/ac108_init.c b/sound/soc/sunxi/ac108_init.c
new file mode 100644
index 0000000..d6144f0
--- /dev/null
+++ b/sound/soc/sunxi/ac108_init.c
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ac108_init - AC108 编码模式配方的内核化（纯 I2C 初始化驱动）
+ *
+ * 绑定 DT 节点 /soc/i2c@1c2ac00/ac108@3b (compatible "x-power,ac108e"，
+ * 旧 voicen overlay 遗留，设备存在但此前无驱动)。probe 即写整份寄存器配方，
+ * 等价 ~/ac108/mic4-record.sh 的配置段；应用随后从 micgen 卡录线上流，
+ * 或经 ALSA 插件 "ac108"（tag 解码）直录 4ch/32bit/48k。
+ *
+ * 不注册任何 ASoC/DAI/PCM —— 只碰 I2C，无 panic 风险面
+ * （此前 boot panic 的是带 .playback DAI 的 snd-soc-ac108e 模块，与此无关）。
+ *
+ * 参数: mode=1(AC108 主,默认,需 ac108m DT)/0(H3 主)；DT 无节点时回退
+ *       用 busnum/address 手工创建 i2c client。
+ */
+#include <linux/module.h>
+#include <linux/i2c.h>
+#include <linux/delay.h>
+#include <linux/of.h>
+
+static int mode = 1;
+static int busnum = 0;
+static int address = 0x3b;	/* 0x3b */
+
+module_param(mode, int, 0644);
+module_param(busnum, int, 0444);
+module_param(address, int, 0444);
+MODULE_PARM_DESC(mode, "1=AC108 I2S master (default, needs ac108m DT), 0=H3 master");
+
+static struct i2c_client *cli;
+static bool bound_via_dt;
+
+static const struct regval {
+	u8 reg, val;
+} recipe[] = {
+	{0x06, 0x01}, {0x07, 0x19}, {0x09, 0x09},	/* 模拟 LDO/VREF */
+	{0x11, 4}, {0x12, 0}, {0x13, 128}, {0x14, 24},	/* PLL 24M->24.576M (精确) */
+	{0x18, 0x01}, {0x10, 0x0b},			/* PLL 锁定/使能 */
+	{0x20, 0x89},	/* SYSCLK<-PLL: 必须 0x89(bit3)! 0x83 实为 MCLK 直通 24M */
+	{0x21, 0x95}, {0x22, 0x95},			/* 模块时钟/复位释放 */
+	{0x32, 0x00},
+	{0x34, 0x5d},	/* 编码模式(ENCD_SEL=bit6)+LJ+偏移 —— 0x3d 不是编码 */
+	{0x35, 0x77},	/* 32bit 采样 + 32bit slot */
+	{0x33, 31},	/* LRCK 半周期 32 BCLK -> 线上 96k (=2x48k) */
+	{0x36, 0x60},	/* SEXT=11 */
+	{0x38, 3}, {0x39, 0x0f}, {0x3a, 0x00},		/* TX1 = 4 槽 */
+	{0x3c, 0xe4},	/* slot1..4 <- adc1..4 恒等 */
+	{0x60, 8},	/* ADC 真实 48k */
+	{0x66, 0x0f},	/* HPF */
+	{0x61, 0x1f},	/* 4 路 ADC */
+	{0xa0, 7}, {0xa7, 7}, {0xae, 7}, {0xb5, 7},	/* micbias+PGA+DSM */
+	{0xbb, 0x0f}, {0xba, 0},
+	{0x90, 0}, {0x91, 0}, {0x92, 0}, {0x93, 0},	/* PGA 0dB */
+	{0x70, 222}, {0x71, 222}, {0x72, 222}, {0x73, 222},	/* 数字音量 +47dB */
+};
+
+static int wr(u8 reg, u8 val)
+{
+	int ret = i2c_smbus_write_byte_data(cli, reg, val);
+	if (ret < 0)
+		pr_err("ac108_init: write 0x%02x<-0x%02x failed: %d\n", reg, val, ret);
+	return ret;
+}
+
+static int rd(u8 reg)
+{
+	return i2c_smbus_read_byte_data(cli, reg);
+}
+
+static int apply_recipe(void)
+{
+	int ret, i;
+
+	/* CHIP_RST: 本芯片复位值是 0x00（0x12 NAK） */
+	if ((ret = wr(0x00, 0x00)))
+		return ret;
+	msleep(500);
+	if ((ret = wr(0x30, 0x00)))	/* GEN off，安静配置 */
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(recipe); i++)
+		if ((ret = wr(recipe[i].reg, recipe[i].val)))
+			return ret;
+
+	if (mode) {
+		wr(0x31, 0x03);		/* 主: BCLK=SYSCLK/4=6.144M */
+		wr(0x30, 0xf5);		/* 主: AC108 驱动 BCLK/LRCK */
+	} else {
+		wr(0x31, 0x00);
+		wr(0x30, 0x35);		/* 从: H3 驱动时钟 */
+	}
+
+	pr_info("ac108_init: recipe applied (mode=%s) "
+		"0x20=%02x 0x34=%02x 0x38=%02x 0x3c=%02x\n",
+		mode ? "AC108-master" : "H3-master",
+		rd(0x20), rd(0x34), rd(0x38), rd(0x3c));
+	return 0;
+}
+
+static int ac108_probe(struct i2c_client *client)
+{
+	cli = client;
+	bound_via_dt = true;
+	return apply_recipe();
+}
+
+static void ac108_remove(struct i2c_client *client)
+{
+	wr(0x30, 0x00);		/* GEN off */
+	pr_info("ac108_init: removed\n");
+}
+
+static const struct of_device_id ac108_of_match[] = {
+	{ .compatible = "x-power,ac108e" },
+	{ .compatible = "x-power,ac108_0" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ac108_of_match);
+
+static struct i2c_device_id ac108_ids[] = {
+	{ "ac108-ctrl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, ac108_ids);
+
+static struct i2c_driver ac108_driver = {
+	.driver = {
+		.name		= "ac108-init",
+		.of_match_table	= ac108_of_match,
+	},
+	.probe		= ac108_probe,
+	.remove		= ac108_remove,
+	.id_table	= ac108_ids,
+};
+
+static int __init ac108_init_mod(void)
+{
+	int ret = i2c_add_driver(&ac108_driver);
+	if (ret)
+		return ret;
+	if (!bound_via_dt) {
+		/* DT 无节点时回退：手工创建 client */
+		struct i2c_adapter *adap = i2c_get_adapter(busnum);
+		if (!adap) {
+			i2c_del_driver(&ac108_driver);
+			return -ENODEV;
+		}
+		cli = i2c_new_client_device(adap, &(struct i2c_board_info){
+				I2C_BOARD_INFO("ac108-ctrl", address) });
+		i2c_put_adapter(adap);
+		if (IS_ERR(cli)) {
+			ret = PTR_ERR(cli);
+			i2c_del_driver(&ac108_driver);
+			return ret;
+		}
+		ret = apply_recipe();
+		if (ret) {
+			i2c_unregister_device(cli);
+			i2c_del_driver(&ac108_driver);
+		}
+	}
+	return ret;
+}
+
+static void __exit ac108_exit_mod(void)
+{
+	if (!bound_via_dt && cli)
+		i2c_unregister_device(cli);
+	i2c_del_driver(&ac108_driver);
+}
+
+module_init(ac108_init_mod);
+module_exit(ac108_exit_mod);
+MODULE_AUTHOR("i");
+MODULE_DESCRIPTION("AC108 encoding-mode register recipe loader (capture init only)");
+MODULE_LICENSE("GPL v2");
