[Unit]
Description=AC108 4-mic -> UAC2 USB microphone bridge (alsaloop)
# 默认 disabled：手动 sudo systemctl start usb-audio-bridge
# 与板端直录互占 hw:1,0（直录前先 stop）
After=usb-gadget.service sound.target
Wants=usb-gadget.service

[Service]
Type=simple
ExecStart=/usr/bin/alsaloop -C ac108 -P hw:CARD=UAC2Gadget -f S16_LE -c 4 -r 48000 -U
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
